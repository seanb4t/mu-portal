model {
  player = actor 'Player' {
    description 'One person who plays on one or more games.'
  }

  games = externalSystem 'MU* games' {
    description 'PennMUSH, TinyMUX, RhostMUSH, AresMUSH and Evennia servers, reached by telnet.'
  }

  collector = externalSystem 'OpenTelemetry collector' {
    description 'An optional collector that the owner runs. It gets traces and metrics over OTLP.'
  }

  mu = system 'mu-portal' {
    description 'One server and zero to many clients for one person.'

    terminal = client 'Terminal client' {
      description 'The default verb of the mu binary. It runs in a terminal.'

      loop = part 'Event loop' {
        description 'Reads the terminal events, the event stream and the call replies, and performs each effect.'
      }
      keymap = part 'Keymap' {
        description 'A table from a key with its modifiers, or a wheel step, to an entry of the registry.'
      }
      registry = part 'Registry' {
        description 'One table of the entries that the player can run, each with its name, argument and Action.'
      }
      update = part 'update' {
        description 'Changes the model for a Msg and returns the effects. It parses a client command and builds the Action of an entry. It does no I/O.'
      }
      state = part 'Model' {
        description 'The focus, the worlds, the pane states by pane id, the editors by world and block id, the lines of a send of each line and the checked layouts.'
      }
      render = part 'view' {
        description 'Asks the solver of mu-config for the rectangle of each block, and renders each block with its state.'
      }
      outputPane = part 'Output pane' {
        description 'A StatefulWidget over a line store. One for each world.'
      }

      loop -> keymap 'a key event'
      keymap -> update 'a registry entry'
      update -> registry 'builds the Action of an entry'
      loop -> update 'a Msg'
      update -> state 'changes'
      update -> loop 'effects'
      loop -> render 'draws a frame'
      render -> state 'reads'
      render -> outputPane 'renders'
    }

    layoutVerb = client 'mu layout' {
      description 'Lists, shows, chooses and changes the layouts of a running server. It never starts a server.'
    }

    configVerb = client 'mu config' {
      description 'Shows the configuration of one client, and asks the server to read its directory again. It never starts a server.'
    }

    devices = client 'Other paired devices' {
      description 'Later clients, for example a phone or a tablet. Each one is paired with the server.'
    }

    server = part 'Server' {
      description 'The mu server verb. It holds every game connection and all state.'

      api = part 'API' {
        description 'ConnectRPC commands and one event stream. It is the only way into the server.'
      }
      sessions = part 'Game sessions' {
        description 'One telnet connection for each world.'
      }
      journal = part 'Journal' {
        description 'The ordered record of events for each world.'
      }
      store = part 'Configuration store' {
        description 'Reads and checks the configuration directory: the worlds, server.toml, the client layers and the layout files in clients/. It resolves the configuration of one client and reloads the client layers. It writes a layout file and the layout choice of a device layer.'
      }

      api -> sessions 'sends input'
      sessions -> journal 'records events'
      journal -> api 'feeds the event stream'
      store -> sessions 'the worlds of the start'
      api -> store 'resolves one client, asks for a reload, and writes a layout or a layout choice'
      store -> api 'each new store hash'
    }

    terminal.loop -> server.api 'commands, event stream and configuration watch'
    configVerb -> server.api 'GetClientConfig and ReloadConfig'
    layoutVerb -> server.api 'ListLayouts, DescribeLayout, UseLayout and EditLayout'
    devices -> server.api 'commands and event stream'
  }

  player -> mu.terminal 'plays in'
  player -> mu.devices 'plays on'
  player -> mu.configVerb 'shows and reloads the configuration'
  player -> mu.layoutVerb 'shows, chooses and changes the layouts'
  mu.server.sessions -> games 'telnet'
  mu.server -> collector 'OTLP traces and metrics, when an endpoint is set'

  workspace = system 'Cargo workspace' {
    description 'The crates behind the mu binary.'

    muProto = crate 'mu-proto' {
      description 'API schema and generated code.'
    }
    muCore = crate 'mu-core' {
      description 'Server engine. It does not know the wire format.'
    }
    muConfig = crate 'mu-config' {
      description 'Client configuration: the fields of a client layer, the key names and the entry names.'
    }
    muFakeServer = crate 'mu-fake-server' {
      description 'Fake games for the tests and for the --fake-world flag.'
    }
    muServer = crate 'mu-server' {
      description 'API server: the adapter between the engine and the schema.'
    }
    muClient = crate 'mu-client' {
      description 'API client, with the resume of the event stream.'
    }
    muTui = crate 'mu-tui' {
      description 'Terminal client.'
    }
    muCli = crate 'mu-cli' {
      description 'The mu binary and its verbs.'
    }

    muServer -> muCore 'depends on'
    muServer -> muProto 'depends on'
    muServer -> muConfig 'depends on'
    muClient -> muProto 'depends on'
    muTui -> muClient 'depends on'
    muTui -> muProto 'depends on'
    muTui -> muConfig 'depends on'
    muFakeServer -> muCore 'depends on'
    muCore -> muFakeServer 'tests depend on'
    muCli -> muCore 'depends on'
    muCli -> muFakeServer 'depends on'
    muCli -> muServer 'depends on'
    muCli -> muTui 'depends on'
    muCli -> muClient 'depends on'
    muCli -> muProto 'depends on'
    muCli -> muConfig 'depends on'
  }
}
