model {
  player = actor 'Player' {
    description 'One person who plays on one or more games.'
  }

  games = externalSystem 'MU* games' {
    description 'PennMUSH, TinyMUX, RhostMUSH, AresMUSH and Evennia servers, reached by telnet.'
  }

  collector = externalSystem 'OpenTelemetry collector' {
    description 'An optional collector that the owner runs. It gets traces and metrics over OTLP.'
  }

  mu = system 'mu-portal' {
    description 'One server and zero to many clients for one person.'

    terminal = client 'Terminal client' {
      description 'The default verb of the mu binary. It runs in a terminal.'
    }

    devices = client 'Other paired devices' {
      description 'Later clients, for example a phone or a tablet. Each one is paired with the server.'
    }

    server = part 'Server' {
      description 'The mu server verb. It holds every game connection and all state.'

      api = part 'API' {
        description 'ConnectRPC commands and one event stream. It is the only way into the server.'
      }
      sessions = part 'Game sessions' {
        description 'One telnet connection for each world.'
      }
      journal = part 'Journal' {
        description 'The ordered record of events for each world.'
      }

      api -> sessions 'sends input'
      sessions -> journal 'records events'
      journal -> api 'feeds the event stream'
    }

    terminal -> server.api 'commands and event stream'
    devices -> server.api 'commands and event stream'
  }

  player -> mu.terminal 'plays in'
  player -> mu.devices 'plays on'
  mu.server.sessions -> games 'telnet'
  mu.server -> collector 'OTLP traces and metrics, when an endpoint is set'

  workspace = system 'Cargo workspace' {
    description 'The crates behind the mu binary.'

    muProto = crate 'mu-proto' {
      description 'API schema and generated code.'
    }
    muCore = crate 'mu-core' {
      description 'Server engine. It does not know the wire format.'
    }
    muServer = crate 'mu-server' {
      description 'API server: the adapter between the engine and the schema.'
    }
    muClient = crate 'mu-client' {
      description 'API client, with the resume of the event stream.'
    }
    muTui = crate 'mu-tui' {
      description 'Terminal client.'
    }
    muCli = crate 'mu-cli' {
      description 'The mu binary and its verbs.'
    }

    muServer -> muCore 'depends on'
    muServer -> muProto 'depends on'
    muClient -> muProto 'depends on'
    muTui -> muClient 'depends on'
    muTui -> muProto 'depends on'
    muCli -> muCore 'depends on'
    muCli -> muServer 'depends on'
    muCli -> muTui 'depends on'
    muCli -> muClient 'depends on'
    muCli -> muProto 'depends on'
  }
}
