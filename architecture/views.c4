views {
  view index {
    title 'System context'
    description 'The player, the clients, the server, the games and the collector.'
    include player, games, collector, mu, mu.terminal, mu.configVerb, mu.devices, mu.server
  }

  view serverAndClients of mu {
    title 'Server and clients'
    description 'The paired devices, the API and the parts of the server.'
    include *, server.*
  }

  view crateLayout of workspace {
    title 'Crate layout'
    description 'The crates and their allowed dependencies.'
    include *
  }

  view terminalClient of mu.terminal {
    title 'Terminal client'
    description 'The parts of mu-tui: the event loop, the keymap, the registry, update, the model, view and the output pane.'
    include *
  }

  dynamic view keyPress {
    title 'One key press'
    description 'Enter sends the text of the pose editor to the world in focus.'
    player -> mu.terminal.loop 'presses Enter'
    mu.terminal.loop -> mu.terminal.keymap 'looks up the key'
    mu.terminal.keymap -> mu.terminal.update 'the entry send'
    mu.terminal.update -> mu.terminal.registry 'builds the Action Submit'
    mu.terminal.update -> mu.terminal.state 'clears the pose editor and returns the pane to the bottom'
    mu.terminal.update -> mu.terminal.loop 'the effect Send'
    mu.terminal.loop -> mu.server.api 'sends the line'
    mu.terminal.loop -> mu.terminal.render 'draws a frame'
    mu.terminal.render -> mu.terminal.state 'reads'
  }

  dynamic view clientStart {
    title 'The start of mu client'
    description 'mu client goes from the server URL to the first frame: the first list, the configuration watch, GetClientConfig, the keymap and the notices.'
    player -> mu.terminal.loop 'runs mu client with a server URL and a device name'
    mu.terminal.loop -> mu.server.api 'lists the worlds'
    mu.terminal.loop -> mu.server.api 'opens WatchConfig'
    mu.terminal.loop <- mu.server.api 'the first store hash'
    mu.terminal.loop -> mu.server.api 'GetClientConfig with the kind, the OS and the device'
    mu.server.api -> mu.server.store 'resolves the layers of the client'
    mu.terminal.loop <- mu.server.api 'the keys, the echo, the revision, the sources and the notices'
    mu.terminal.loop -> mu.terminal.update 'applies the reply'
    mu.terminal.update -> mu.terminal.keymap 'builds the keymap'
    mu.terminal.update -> mu.terminal.state 'sets the echo and adds the notices'
    mu.terminal.loop -> mu.terminal.render 'draws the first frame'
  }

  dynamic view configReload {
    title 'A reload of the configuration'
    description 'mu config reload makes the server read its directory again, and each attached client gets its new keymap.'
    player -> mu.configVerb 'runs mu config reload'
    mu.configVerb -> mu.server.api 'ReloadConfig'
    mu.server.api -> mu.server.store 'reads and checks the directory again'
    mu.configVerb <- mu.server.api 'the bad files, and the files that apply at the restart'
    mu.server.store -> mu.server.api 'a new store hash'
    mu.terminal.loop <- mu.server.api 'the new store hash on WatchConfig'
    mu.terminal.loop -> mu.server.api 'GetClientConfig'
    mu.terminal.loop <- mu.server.api 'a reply with a new revision'
    mu.terminal.loop -> mu.terminal.update 'applies the reply'
    mu.terminal.update -> mu.terminal.keymap 'replaces the keymap'
    mu.terminal.update -> mu.terminal.state 'replaces the echo and adds each new notice'
    mu.terminal.loop -> mu.terminal.render 'draws a frame'
  }

  dynamic view layoutSave {
    title 'A save of the layout'
    description 'A change of the layout in the client goes to the server, which writes the file and gives each attached client the result.'
    player -> mu.terminal.loop 'a command, a drag or Enter in arrange mode'
    mu.terminal.loop -> mu.terminal.update 'changes the plan of the layout'
    mu.terminal.loop -> mu.terminal.render 'draws the new layout at once'
    mu.terminal.loop -> mu.server.api 'SaveLayout or UseLayout'
    mu.server.api -> mu.server.store 'checks the plan, writes the file whole, and reads the directory again'
    mu.terminal.loop <- mu.server.api 'the result of the save'
    mu.server.store -> mu.server.api 'a new store hash'
    mu.terminal.loop <- mu.server.api 'the new store hash on WatchConfig'
    mu.terminal.loop -> mu.server.api 'GetClientConfig'
    mu.terminal.loop <- mu.server.api 'a reply with the saved layout'
    mu.terminal.loop -> mu.terminal.update 'applies the reply'
  }
}
