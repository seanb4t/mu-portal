{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "customManagers:dockerfileVersions"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The hk package pins in hk.pkl",
      "managerFilePatterns": [
        "/^hk\\.pkl$/"
      ],
      "matchStrings": [
        "jdx/hk/releases/download/v(?<currentValue>[0-9.]+)/hk@",
        "/hk@(?<currentValue>[0-9.]+)#"
      ],
      "depNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "The RhostMUSH commit of the telnet spike, which follows the master branch because the repository has no tags",
      "managerFilePatterns": [
        "/^spikes/telnet-engine/servers/rhostmush/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG RHOSTMUSH_VERSION=(?<currentDigest>[0-9a-f]{40})"
      ],
      "depNameTemplate": "RhostMUSH/trunk",
      "packageNameTemplate": "https://github.com/RhostMUSH/trunk",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "The commit of the ratatui-textarea fork in [patch.crates-io], which follows the branch mu. The cargo manager reads no [patch] table",
      "managerFilePatterns": [
        "/^Cargo\\.toml$/"
      ],
      "matchStrings": [
        "git = \"https://github\\.com/seanb4t/ratatui-textarea\", rev = \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "depNameTemplate": "seanb4t/ratatui-textarea",
      "packageNameTemplate": "https://github.com/seanb4t/ratatui-textarea",
      "currentValueTemplate": "mu",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "hk.pkl and mise.toml pin the same hk release, and a test compares them",
      "groupName": "hk",
      "matchPackageNames": [
        "hk",
        "jdx/hk"
      ]
    },
    {
      "description": "ratatui-termina uses one termina version and mu-tui must use the same one, so they move together",
      "groupName": "termina",
      "matchPackageNames": [
        "termina",
        "ratatui",
        "ratatui-termina",
        "ratatui-textarea"
      ]
    },
    {
      "description": "ratatui-termina 0.1 needs termina 0.3, and cargo-deny refuses two termina versions. Lift this when a ratatui-termina release moves to termina 0.4",
      "matchPackageNames": [
        "termina"
      ],
      "allowedVersions": "<0.4"
    }
  ]
}
